# Local development only. Copy to .env. Hosted values live in Railway (API) and GitHub variables/secrets (web build).
DATABASE_URL=postgres://app:app@localhost:5432/app
PORT=3001
CORS_ORIGIN=http://localhost:5174

# Accounts. Locally emails are printed by the API instead of sent, and Turnstile uses Cloudflare's always-pass
# test keys. BETTER_AUTH_SECRET here is for local use only; hosted environments get their own random secret.
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=local-development-secret-not-for-hosting-0000
EMAIL_TRANSPORT=console
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# The Expo app (apps/app).
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_WEB_URL=http://localhost:5174
EXPO_PUBLIC_FEATURE_ACCOUNTS=true
EXPO_PUBLIC_FEATURE_LAYOUT_EDITOR=true
# "Start from blank" in the layout editor (needs the layout editor). Off unless set to true.
EXPO_PUBLIC_FEATURE_BLANK_LAYOUT=true
# Where a photo doesn't cover its cell, the rest of the cell shows a blurred copy of it. Off unless set to true.
EXPO_PUBLIC_FEATURE_BLUR_FILL=true
# Looks: one-tap filters on every photo, in the Style tool. Off unless set to true.
EXPO_PUBLIC_FEATURE_LOOKS=true
# "Describe a layout" in the layout editor: iOS only, on the iPhone's own model (needs the layout editor). Off unless set to true.
EXPO_PUBLIC_FEATURE_DESCRIBE_LAYOUT=true
# Grid layouts move the lines between cells to suit the photos' subjects. Off unless set to true.
EXPO_PUBLIC_FEATURE_FIT_LAYOUTS=true
# The Text tool: captions on the collage. Off unless set to true.
EXPO_PUBLIC_FEATURE_TEXT=true
# Sends usage counts to the API. Off by default. To see them stored, also set USAGE_INGEST_ENABLED=true.
EXPO_PUBLIC_FEATURE_USAGE=false
EXPO_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# StoryStitch Plus: only Plus can turn the mark off. Off by default; needs accounts, the API and PAYMENTS_ENABLED.
# The RevenueCat keys are its public ones (sandbox keys locally): the web app's (Paddle) and the iOS app's.
EXPO_PUBLIC_FEATURE_PLUS=false
# EXPO_PUBLIC_REVENUECAT_WEB_KEY=
# EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# The /admin dashboard (web only). Off by default; needs accounts, the API and ADMIN_ENABLED.
EXPO_PUBLIC_FEATURE_ADMIN=false
# Timing numbers on screen, for checking speed on a real phone. Leave it off everywhere else.
# EXPO_PUBLIC_PERF_READOUT=true
# Which iOS app apps/app/app.config.ts describes: production (default) or staging. EAS builds set it in eas.json;
# Expo doesn't read it from this file, so to use it locally set it on the command.
# APP_VARIANT=staging

# The iOS app: the URL scheme trusted for sign-in, and the oldest version still supported.
APP_SCHEME=storystitch://
MIN_IOS_APP_VERSION=1.0.0

# Counts usage events sent to the API. Off by default.
USAGE_INGEST_ENABLED=false

# The /admin/stats route and authenticator-app sign-in for admin accounts. Off by default. Admins are set by hand in SQL.
ADMIN_ENABLED=false

# StoryStitch Plus (RevenueCat). Off by default. Turning it on needs all three RevenueCat values: a v2 secret key that
# can read customers and entitlements, the project ID, and the Authorization value set on the webhook (32+ characters).
PAYMENTS_ENABLED=false
# REVENUECAT_SECRET_KEY=
# REVENUECAT_PROJECT_ID=
# REVENUECAT_WEBHOOK_SECRET=
