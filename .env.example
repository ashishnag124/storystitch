# Local development only. Copy to .env. Hosted values live in Railway (API) and GitHub variables/secrets (web build).
DATABASE_URL=postgres://app:app@localhost:5432/app
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
VITE_API_URL=http://localhost:3001

# Accounts. Locally emails are printed by the API instead of sent, and Turnstile uses Cloudflare's always-pass
# test keys. BETTER_AUTH_SECRET here is for local use only; hosted environments get their own random secret.
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=local-development-secret-not-for-hosting-0000
EMAIL_TRANSPORT=console
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_FEATURE_ACCOUNTS=true
VITE_FEATURE_LAYOUT_EDITOR=true
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# The same values for the Expo app (apps/app).
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_WEB_URL=http://localhost:5174
EXPO_PUBLIC_FEATURE_ACCOUNTS=true
EXPO_PUBLIC_FEATURE_LAYOUT_EDITOR=true
EXPO_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Which iOS app apps/app/app.config.ts describes: production (default) or staging. EAS builds set it in eas.json;
# Expo doesn't read it from this file, so to use it locally set it on the command.
# APP_VARIANT=staging

# The iOS app: the URL scheme trusted for sign-in, and the oldest version still supported.
APP_SCHEME=storystitch://
MIN_IOS_APP_VERSION=1.0.0

# Counts usage events sent to the API. Off by default.
USAGE_INGEST_ENABLED=false
