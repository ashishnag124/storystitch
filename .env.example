# Local development only. Copy to .env. Hosted values live in Railway (API) and GitHub variables/secrets (web build).
DATABASE_URL=postgres://app:app@localhost:5432/app
PORT=3001
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3001

# Accounts. Locally emails are printed by the API instead of sent, and Turnstile uses Cloudflare's always-pass
# test keys. BETTER_AUTH_SECRET here is for local use only; hosted environments get their own random secret.
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=local-development-secret-not-for-hosting-0000
EMAIL_TRANSPORT=console
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_FEATURE_ACCOUNTS=true
VITE_FEATURE_LAYOUT_EDITOR=true
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
