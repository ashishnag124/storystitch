{
  "name": "@storystitch/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@hono/node-server": "^2.1.5",
    "@storystitch/shared": "workspace:*",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "pg": "^8.23.1",
    "resend": "^6.37.0",
    "zod": "^4.6.7"
  }
}
