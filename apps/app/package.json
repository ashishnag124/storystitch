{
  "name": "@storystitch/app",
  "private": true,
  "version": "0.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && expo start --web --port 5174",
    "build": "node scripts/prepare-assets.mjs && expo export -p web",
    "build:ios": "expo export -p ios --output-dir dist-ios",
    "prebuild:ios": "LANG=en_US.UTF-8 expo prebuild -p ios",
    "build:e2e": "node scripts/prepare-assets.mjs && EXPO_PUBLIC_FEATURE_ACCOUNTS=false EXPO_PUBLIC_FEATURE_BLUR_FILL=true EXPO_PUBLIC_FEATURE_LOOKS=true EXPO_PUBLIC_FEATURE_SHUFFLE=true expo export -p web --output-dir dist-e2e && EXPO_PUBLIC_FEATURE_ACCOUNTS=true EXPO_PUBLIC_FEATURE_LOOKS=false EXPO_PUBLIC_FEATURE_SHUFFLE=false EXPO_PUBLIC_FEATURE_LAYOUT_EDITOR=true EXPO_PUBLIC_FEATURE_BLANK_LAYOUT=true EXPO_PUBLIC_FEATURE_BLUR_FILL=true EXPO_PUBLIC_FEATURE_DESCRIBE_LAYOUT=true EXPO_PUBLIC_FEATURE_USAGE=true EXPO_PUBLIC_FEATURE_PLUS=true EXPO_PUBLIC_FEATURE_ADMIN=true EXPO_PUBLIC_API_URL=http://localhost:3010 EXPO_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA expo export -p web --output-dir dist-e2e-accounts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "e2e": "pnpm run build:e2e && playwright test"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.14",
    "@expo/metro-runtime": "~58.0.15",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.0",
    "@revenuecat/purchases-js": "1.74.0",
    "@shopify/react-native-skia": "2.14.0",
    "@storystitch/client": "workspace:*",
    "@storystitch/layout-engine": "workspace:*",
    "@storystitch/shared": "workspace:*",
    "better-auth": "^1.7.14",
    "expo": "58.0.22",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-network": "~58.0.4",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-updates": "~58.0.20",
    "expo-web-browser": "~58.0.6",
    "heic-to": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
