{
  "cli": {
    "version": ">= 27.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "pnpm": "12.16.1",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_API_URL": "https://api-staging.storystitch.ashishnag.com",
        "EXPO_PUBLIC_WEB_URL": "https://staging.storystitch.ashishnag.com",
        "EXPO_PUBLIC_FEATURE_ACCOUNTS": "true",
        "EXPO_PUBLIC_FEATURE_LAYOUT_EDITOR": "true",
        "EXPO_PUBLIC_FEATURE_USAGE": "true",
        "EXPO_PUBLIC_FEATURE_FIT_LAYOUTS": "true",
        "EXPO_PUBLIC_FEATURE_BLANK_LAYOUT": "true"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal"
    },
    "testflight": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true
    },
    "production": {
      "pnpm": "12.16.1",
      "channel": "production",
      "environment": "production",
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_API_URL": "https://api.storystitch.ashishnag.com",
        "EXPO_PUBLIC_WEB_URL": "https://storystitch.ashishnag.com",
        "EXPO_PUBLIC_FEATURE_ACCOUNTS": "true",
        "EXPO_PUBLIC_FEATURE_LAYOUT_EDITOR": "true",
        "EXPO_PUBLIC_FEATURE_USAGE": "true",
        "EXPO_PUBLIC_FEATURE_FIT_LAYOUTS": "true"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6831768599"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6831817943"
      }
    }
  }
}
