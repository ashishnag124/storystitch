{
  "cli": {
    "version": ">= 27.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "pnpm": "12.16.1",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_API_URL": "https://api-staging.storystitch.ashishnag.com",
        "EXPO_PUBLIC_WEB_URL": "https://staging.storystitch.ashishnag.com",
        "EXPO_PUBLIC_FEATURE_ACCOUNTS": "true",
        "EXPO_PUBLIC_FEATURE_LAYOUT_EDITOR": "true"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal"
    },
    "testflight": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID"
      }
    }
  }
}
