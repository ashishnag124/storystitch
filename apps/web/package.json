{
  "name": "@storystitch/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-mediapipe.mjs && vite",
    "build": "node scripts/copy-mediapipe.mjs && tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview",
    "e2e": "pnpm run build:e2e && playwright test",
    "build:e2e": "VITE_FEATURE_ACCOUNTS=false vite build --outDir dist-e2e --emptyOutDir --mode e2e && VITE_FEATURE_ACCOUNTS=true VITE_FEATURE_LAYOUT_EDITOR=true VITE_API_URL=http://localhost:3010 VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA vite build --outDir dist-e2e-accounts --emptyOutDir --mode e2e"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.0",
    "@storystitch/client": "workspace:*",
    "@storystitch/layout-engine": "workspace:*",
    "@storystitch/shared": "workspace:*",
    "better-auth": "^1.7.14",
    "heic-to": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
