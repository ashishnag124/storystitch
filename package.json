{
  "name": "storystitch",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "docker compose up -d --wait && turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "format": "prettier --write .",
    "e2e": "turbo run e2e",
    "qa": "node scripts/qa.mjs",
    "db:generate": "pnpm --filter @storystitch/api db:generate",
    "db:migrate": "pnpm --filter @storystitch/api db:migrate",
    "usage:report": "pnpm --silent --filter @storystitch/api usage:report"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript-eslint": "^8.72.1"
  }
}
