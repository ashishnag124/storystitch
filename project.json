{
  "name": "storystitch",
  "apps": {
    "web": {
      "path": "apps/web",
      "stack": "vite-react",
      "host": "cloudflare-pages",
      "pagesProject": "storystitch-web",
      "pagesProjectStaging": "storystitch-web-staging"
    },
    "app": {
      "path": "apps/app",
      "stack": "expo",
      "host": "cloudflare-pages",
      "pagesProject": "storystitch-web",
      "pagesProjectStaging": "storystitch-web-staging",
      "replaces": "web"
    },
    "api": {
      "path": "apps/api",
      "stack": "hono-drizzle",
      "host": "railway",
      "railwayProject": "storystitch",
      "railwayService": "api",
      "database": "railway-postgres"
    }
  },
  "features": {},
  "environments": {
    "local": {
      "web": "http://localhost:5173",
      "api": "http://localhost:3001"
    },
    "staging": {
      "branch": "main",
      "web": "https://staging.storystitch.ashishnag.com",
      "api": "https://api-staging.storystitch.ashishnag.com"
    },
    "production": {
      "branch": "production",
      "web": "https://storystitch.ashishnag.com",
      "api": "https://api.storystitch.ashishnag.com"
    }
  }
}
